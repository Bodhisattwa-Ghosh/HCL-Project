# HTTP
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Data services
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pulsepoll
REDIS_URL=redis://localhost:6379/0

# Security - replace with a long, random secret outside local development.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_TTL_HOURS=168

# Set true only when serving over HTTPS. Local development should remain false.
COOKIE_SECURE=false
# Use "none" only for an HTTPS frontend/API pair on different sites.
COOKIE_SAME_SITE=lax
